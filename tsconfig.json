{
	"compilerOptions": {
		"rootDir": "./web",
		"outDir": "./build",

		"strict": true,
		"jsx": "react-jsx",

		"target": "esnext",
		"lib": ["esnext", "dom"],

		"module": "esnext",
		"moduleResolution": "bundler",

		"noUnusedLocals": true,
		"noUnusedParameters": true,

		"incremental": true,
		"tsBuildInfoFile": "./build/.tsbuildinfo"
	},
	"include": ["./web", "./web/global.d.ts"]
}
