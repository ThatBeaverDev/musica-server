{
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./build",

		"strict": true,
		"jsx": "react-jsx",

		"target": "esnext",
		"lib": ["esnext", "dom"],

		"module": "esnext",
		"moduleResolution": "bundler",

		"noUnusedLocals": true,
		"noUnusedParameters": true,

		"incremental": true,
		"tsBuildInfoFile": "./build/.tsbuildinfo"
	},
	"include": ["./src/client", "./src/client/global.d.ts"]
}
